# Copy to .env with scripts/init_env.sh (generates random passwords).
# .env is git-ignored: never commit real credentials.

# --- Oracle container / database ---
ORACLE_CONTAINER=oracle19c
ORACLE_CDB_SID=ORCLCDB
ORACLE_PDB=ORCLPDB1
ORACLE_PDB_SERVICE=orclpdb1
ORACLE_HOST=host.docker.internal
ORACLE_PORT=1521
DATAFILE_DIR=/opt/oracle/oradata/ORCLCDB/ORCLPDB1

# --- Application accounts (least privilege) ---
TELCO_OWNER_PASSWORD=change_me
TELCO_APP_PASSWORD=change_me
TELCO_ANALYST_PASSWORD=change_me

# --- Dataset ---
# Scale (ROWS_PER_MONTH, CUSTOMERS) is free. Tests, benchmark and demo are written for
# this calendar (2020-11 + 72 months, as of 2026-11) and refuse another one.
DATA_START_MONTH=2020-11
DATA_MONTHS=72
AS_OF_MONTH=2026-11
ROWS_PER_MONTH=330000
CUSTOMERS=500000

# --- Safety: abort data generation if the host has less free disk (GB) ---
# A full load needs ~7 GB inside Docker; space freed by reset.sh is reused.
MIN_HOST_FREE_GB=10
